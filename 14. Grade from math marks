marks = int(input("Enter marks (0-100): "))
if not 0 <= marks <= 100:
    print("Invalid marks")
elif marks >= 90:
    print("Grade: O")
elif marks >= 80:
    print("Grade: A+")
elif marks >= 70:
    print("Grade: A")
elif marks >= 60:
    print("Grade: B")
elif marks >= 50:
    print("Grade: C")
elif marks >= 40:
    print("Grade: P")
else:
    print("Grade: F")
